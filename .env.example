# Where hire-us inquiries go: any endpoint that accepts a JSON POST
# (Slack or Discord incoming webhook, Zapier, Make, n8n, a CRM).
# Unset: development logs inquiries; production refuses them.
CONTACT_WEBHOOK_URL=

# Optional: send applications to join to a different webhook. Unset: they use
# CONTACT_WEBHOOK_URL, with "type": "application" in the body.
APPLY_WEBHOOK_URL=
